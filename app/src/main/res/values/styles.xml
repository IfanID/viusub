<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tombol panel kontrol. Tinggi 44dp memberi sasaran sentuh yang lebih
      nyaman tanpa memakan terlalu banyak ruang transkrip.
    -->
    <style name="ThinButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/panel_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PrimaryButton" parent="ThinButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Aksi yang menghapus rekaman diberi warna peringatan, bukan aksen. -->
    <style name="DangerButton" parent="ThinButton">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/provisional_mark</item>
    </style>

    <!-- Tombol dialog memakai bahasa visual panel: tanpa huruf kapital
         paksa, teks medium, dan warna aksen/sekunder dari tema aplikasi. -->
    <style name="Widget.ViuSub.DialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.ViuSub.DialogButton.Accent" parent="Widget.ViuSub.DialogButton">
        <item name="android:textColor">@color/panel_accent</item>
    </style>

    <!-- Judul dialog memakai warna teks panel, bukan putih standar. -->
    <style name="TextAppearance.ViuSub.DialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/panel_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.ViuSub.DialogTitle" parent="android:Widget">
        <item name="android:textAppearance">@style/TextAppearance.ViuSub.DialogTitle</item>
        <item name="android:maxLines">2</item>
    </style>
</resources>
