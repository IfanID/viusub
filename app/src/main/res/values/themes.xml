<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Aplikasi ini selalu tampil gelap. Memakai DayNight membuat dialog dan
      kontrol bawaan berubah terang saat sistem memakai mode terang,
      sementara latar aplikasi tetap hitam. NoActionBar menjaga seluruh
      permukaan tetap satu warna.
    -->
    <style name="Theme.ViuSub" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/panel_bottom</item>
        <item name="android:statusBarColor">@color/panel_bottom</item>
        <item name="android:navigationBarColor">@color/panel_bottom</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="colorPrimary">@color/panel_accent</item>
        <item name="colorPrimaryDark">@color/panel_bottom</item>
        <item name="colorAccent">@color/panel_accent</item>
        <item name="android:colorAccent">@color/panel_accent</item>
        <item name="colorControlActivated">@color/panel_accent</item>
        <item name="colorControlNormal">@color/meta_text</item>
        <item name="colorControlHighlight">@color/accent_ripple</item>
        <item name="colorButtonNormal">@color/surface_raised</item>
        <item name="android:textColorHighlight">@color/accent_ripple</item>
    </style>

    <!--
      Splash bawaan Android 12+. Ikon peluncur dipakai lagi di sini supaya
      transisi dari ikon ke layar Home terasa satu identitas. Latar ikon
      dibuat sama dengan latar splash agar tidak muncul lingkaran berbeda.
    -->
    <style name="Theme.ViuSub.Splash" parent="Theme.ViuSub">
        <item name="android:windowSplashScreenBackground">@color/surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/surface</item>
    </style>
</resources>
