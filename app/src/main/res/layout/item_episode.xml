<?xml version="1.0" encoding="utf-8"?>
<!--
  Root layout inilah yang dijadikan target klik oleh EpisodeAdapter
  (itemView.setOnClickListener). Jadi atribut clickable/focusable harus ada
  di sini, bukan di LinearLayout di dalamnya: kalau view anak yang menyerap
  sentuhan, event tidak pernah naik ke root dan episode tidak bisa dibuka.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="11dp"
        android:paddingEnd="10dp"
        android:paddingBottom="11dp">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="112dp"
            android:layout_height="63dp"
            android:background="@drawable/bg_thumb"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/panel_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:textColor="@color/meta_text"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/chevron"
            android:layout_width="18dp"
            android:layout_height="63dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="@color/text_tertiary"
            android:textSize="22sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="140dp"
        android:background="@color/divider_soft" />

</LinearLayout>
