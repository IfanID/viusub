<?xml version="1.0" encoding="utf-8"?>
<!--
  Root layout inilah yang dijadikan target klik oleh EpisodeAdapter
  (itemView.setOnClickListener). Jadi atribut clickable/focusable harus ada
  di sini, bukan di LinearLayout di dalamnya: kalau view anak yang menyerap
  sentuhan, event tidak pernah naik ke root dan episode tidak bisa dibuka.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="112dp"
            android:layout_height="63dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_thumb"
            android:clipToOutline="true"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:textSize="14sp"
                android:textColor="@color/panel_text" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/meta_text" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="140dp"
        android:background="@color/divider" />

</LinearLayout>
