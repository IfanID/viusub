<?xml version="1.0" encoding="utf-8"?>
<!--
  WebView penuh, tanpa split. Bar live menempel tepat di bawah video dan
  menjadi kepala panel rekaman: kartu statistik dan transkrip cue mengisi
  sisa area hitam sampai dasar layar.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_bottom">

    <!--
      Wadah video. WebView ada di dalamnya, dan tampilan fullscreen native
      (custom view dari WebChromeClient) ditambahkan ke wadah yang sama
      saat halaman meminta fullscreen.

      Badge dan bar melayang sengaja DI LUAR wadah ini dan ditulis setelah
      pada layout, jadi keduanya tetap berada di atas video fullscreen.
    -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!--
      Panel rekaman: kartu statistik + transkrip cue. Tepat di bawah bar
      live, mengisi sisa area hitam sampai dasar layar.

      Ditulis SEBELUM layar sapaan supaya sapuan itu tetap menutupinya
      selama pemain belum siap. Sifat clickable menahan sentuhan di area
      ini agar tidak jatuh ke WebView di belakangnya.
    -->
    <LinearLayout
        android:id="@+id/recorderPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@color/panel_bottom"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/liveBar">

        <!-- Ringkasan sesi: lima metrik, progress cakupan, lalu posisi. -->
        <LinearLayout
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_stats_panel"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statCueValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0"
                        android:textColor="@color/panel_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="@string/stat_cue"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:background="@color/divider_soft" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statLiveValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0"
                        android:textColor="@color/panel_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="@string/stat_live"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:background="@color/divider_soft" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statReplayValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0"
                        android:textColor="@color/cue_number"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="@string/stat_replay"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:background="@color/divider_soft" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statCoverageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0.0%"
                        android:textColor="@color/panel_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="@string/stat_coverage"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:background="@color/divider_soft" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statGapValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0"
                        android:textColor="@color/provisional_mark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12"
                        android:text="@string/stat_gap"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/coverageBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:indeterminate="false"
                android:max="1000"
                android:maxHeight="3dp"
                android:minHeight="3dp"
                android:progress="0"
                android:progressDrawable="@drawable/progress_coverage" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statPosition"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/meta_text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/statRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/meta_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/jumpStatusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_jump_status"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="7dp"
            android:paddingEnd="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/jumpStatusProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="9dp"
                android:indeterminateTint="@color/panel_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/jumpStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/panel_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/jumpStatusAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="44dp"
                android:minWidth="48dp"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/panel_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/jumpStatusClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="44dp"
                android:minWidth="48dp"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:text="@string/jump_action_close"
                android:textColor="@color/meta_text"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/transcriptBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/transcriptList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/transcriptEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawablePadding="12dp"
                    android:drawableTop="@drawable/ic_subtitles"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:text="@string/transcript_waiting"
                    android:textColor="@color/meta_text"
                    android:textSize="13sp" />

                <!--
                  Tombol melayang untuk kembali ke cue live. Hanya muncul
                  saat daftar digulir menjauh dari puncak; padding bawah
                  daftar diatur dinamis dari kode supaya baris terakhir
                  tidak tertutup tombol.
                -->
                <TextView
                    android:id="@+id/btnJumpLive"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_jump_live"
                    android:clickable="true"
                    android:contentDescription="@string/transcript_jump_live_desc"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:outlineProvider="background"
                    android:text="@string/transcript_jump_live_symbol"
                    android:textColor="@color/panel_accent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      Layar sapaan. Muncul sesaat setelah episode diketuk dari Home:
      thumbnail, judul, dan status menyiapkan pemain. Meluruh keluar begitu
      <video> di halaman hidup, supaya yang terlihat setelahnya adalah
      pemain dalam tampilan yang sudah benar — bukan halaman yang setengah
      terpasang.

      Sengaja clickable: selama pemain belum siap, sentuhan ditahan di
      sini supaya tidak mengenai area WebView yang belum siap.
    -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_splash"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/splashContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/viusub_logo_horizontal" />

            <ImageView
                android:id="@+id/splashCover"
                android:layout_width="240dp"
                android:layout_height="135dp"
                android:background="@drawable/bg_thumb"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:elevation="10dp"
                android:outlineProvider="background"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/splashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:textColor="@color/panel_text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/splashStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="20dp"
                android:background="@color/panel_accent" />
        </LinearLayout>
    </FrameLayout>

    <!--
      Indikator nomor cue. Isinya satu angka saja: jumlah cue yang sudah
      terekam. Hanya muncul saat video fullscreen; di tampilan biasa
      disembunyikan supaya pojok layar bersih.

      Sengaja tidak clickable/focusable: view yang tidak mengonsumsi
      sentuhan akan dilewati, dan event-nya jatuh ke WebView di
      bawahnya. Jadi area ini tetap bisa dipakai seperti biasa.
    -->
    <TextView
        android:id="@+id/cueBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_cue_badge"
        android:clickable="false"
        android:elevation="4dp"
        android:focusable="false"
        android:fontFamily="monospace"
        android:gravity="center"
        android:minHeight="30dp"
        android:minWidth="30dp"
        android:outlineProvider="background"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="@color/panel_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      Bar live. Posisinya diatur MainActivity: tepat di bawah <video>.
      Baris atas menampilkan status live, judul episode, dan pill LIVE;
      baris bawah menampilkan subtitle yang sedang tampil.
    -->
    <!--
      Kepala pemutar: judul berada di luar kartu preview, tepat di atas
      kartu subtitle. Baris judul memakai latar transparan supaya tidak
      menyatu dengan kartu preview di bawahnya, tetapi teksnya tetap
      sejajar dengan isi kartu.
    -->
    <LinearLayout
        android:id="@+id/liveBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="2dp"
            android:paddingEnd="14dp"
            android:paddingBottom="2dp">

            <View
                android:id="@+id/liveDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_live_dot" />

            <TextView
                android:id="@+id/episodeTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/panel_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/livePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_live_pill"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="@string/live_pill"
                android:textColor="@color/panel_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/livePreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_live_bar"
            android:elevation="6dp"
            android:outlineProvider="background"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/liveText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:maxLines="2"
                android:text="@string/panel_idle"
                android:textColor="@color/panel_accent"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!--
      Panel kontrol, dipisah dari bar live. Semua tombol dan pengaturan
      berkumpul di satu tempat di dasar layar supaya bar live tetap bersih
      dan area transkrip di atasnya punya ruang lega.
    -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="10dp"
        android:orientation="vertical"
        android:outlineProvider="background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveSrt"
                    style="@style/PrimaryButton"
                    android:text="@string/btn_save_srt" />

                <Button
                    android:id="@+id/btnSaveJson"
                    style="@style/ThinButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_save_json" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/divider_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickFolder"
                    style="@style/ThinButton"
                    android:text="@string/btn_pick_folder" />

                <Button
                    android:id="@+id/btnReset"
                    style="@style/DangerButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_reset" />

                <Button
                    android:id="@+id/btnInfo"
                    style="@style/ThinButton"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_info" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/chkKeepScreenOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/panel_accent"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:paddingStart="2dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/chk_keep_screen_on"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!--
      Notifikasi penyimpanan. Muncul dengan animasi kecil saat ekspor
      dimulai dan selesai ("Menyimpan…" lalu "Tersimpan: nama file").
      Ditaruh tepat di atas panel kontrol — dekat dengan tombol yang
      ditekan, tanpa menutupi video.
    -->
    <TextView
        android:id="@+id/saveToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_save_toast"
        android:clickable="false"
        android:elevation="8dp"
        android:focusable="false"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="3"
        android:maxWidth="320dp"
        android:outlineProvider="background"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="@color/panel_accent"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
