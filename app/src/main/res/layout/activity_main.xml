<?xml version="1.0" encoding="utf-8"?>
<!--
  WebView penuh, tanpa split. Bar live menempel tepat di bawah video dan
  menjadi kepala panel rekaman: strip statistik dan transkrip cue mengisi
  sisa area hitam sampai dasar layar.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_bottom">

    <!--
      Wadah video. WebView ada di dalamnya, dan tampilan fullscreen native
      (custom view dari WebChromeClient) ditambahkan ke wadah yang sama
      saat halaman meminta fullscreen.

      Badge dan bar melayang sengaja DI LUAR wadah ini dan ditulis setelah
      pada layout, jadi keduanya tetap berada di atas video fullscreen.
    -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!--
      Panel rekaman: strip statistik + transkrip cue yang sudah lewat.
      Tepat di bawah bar live, mengisi sisa area hitam sampai dasar layar.

      Ditulis SEBELUM layar sapaan supaya sapuan itu tetap menutupinya
      selama pemain belum siap. Sifat clickable menahan sentuhan di area
      ini agar tidak jatuh ke WebView di belakangnya.
    -->
    <LinearLayout
        android:id="@+id/recorderPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@color/panel_bottom"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/liveBar">

        <TextView
            android:id="@+id/transcriptStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/meta_text"
            android:textSize="10sp"
            android:text="@string/transcript_waiting" />

        <LinearLayout
            android:id="@+id/transcriptBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/transcriptList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/transcriptEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:textColor="@color/meta_text"
                    android:textSize="12sp"
                    android:text="@string/transcript_waiting" />

                <!--
                  Tombol melayang untuk kembali ke cue live. Hanya muncul
                  saat daftar digulir menjauh dari puncak; padding bawah
                  daftar diatur dinamis dari kode supaya baris terakhir
                  tidak tertutup tombol.
                -->
                <TextView
                    android:id="@+id/btnJumpLive"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_jump_live"
                    android:clickable="true"
                    android:contentDescription="@string/transcript_jump_live_desc"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:outlineProvider="background"
                    android:text="@string/transcript_jump_live_symbol"
                    android:textColor="@color/panel_accent"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      Layar sapaan. Muncul sesaat setelah episode diketuk dari Home:
      thumbnail, judul, dan status menyiapkan pemain. Meluruh keluar begitu
      <video> di halaman hidup, supaya yang terlihat setelahnya adalah
      pemain dalam tampilan yang sudah benar — bukan halaman yang setengah
      terpasang.

      Sengaja clickable: selama pemain belum siap, sentuhan ditahan di
      sini supaya tidak mengenai area WebView yang belum siap.
    -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/splashContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <ImageView
                android:id="@+id/splashCover"
                android:layout_width="220dp"
                android:layout_height="124dp"
                android:background="@drawable/bg_thumb"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/splashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!--
      Indikator nomor cue. Isinya satu angka saja: jumlah cue yang sudah
      terekam. Hanya muncul saat video fullscreen; di tampilan biasa
      disembunyikan supaya pojok layar bersih.

      Sengaja tidak clickable/focusable: view yang tidak mengonsumsi
      sentuhan akan dilewati, dan event-nya jatuh ke WebView di
      bawahnya. Jadi area ini tetap bisa dipakai seperti biasa.
    -->
    <TextView
        android:id="@+id/cueBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_cue_badge"
        android:clickable="false"
        android:focusable="false"
        android:fontFamily="monospace"
        android:gravity="center"
        android:minWidth="26dp"
        android:minHeight="26dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/panel_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      Bar live. Posisinya diatur MainActivity: tepat di bawah <video>.
      Isinya hanya satu baris subtitle — tombol-tombol pindah ke panel
      kontrol terpisah di dasar layar.
    -->
    <LinearLayout
        android:id="@+id/liveBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_live_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/liveText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/panel_accent"
            android:textSize="15sp"
            android:text="@string/panel_idle" />
    </LinearLayout>

    <!--
      Panel kontrol, dipisah dari bar live. Semua tombol dan pengaturan
      berkumpul di satu tempat di dasar layar supaya bar live tetap bersih
      dan area transkrip di atasnya punya ruang lega.
    -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSaveSrt"
                    style="@style/ThinButton"
                    android:text="@string/btn_save_srt" />

                <Button
                    android:id="@+id/btnSaveJson"
                    style="@style/ThinButton"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_save_json" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickFolder"
                    style="@style/ThinButton"
                    android:text="@string/btn_pick_folder" />

                <Button
                    android:id="@+id/btnReset"
                    style="@style/ThinButton"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_reset" />

                <Button
                    android:id="@+id/btnInfo"
                    style="@style/ThinButton"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_info" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/chkKeepScreenOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/panel_text"
                android:textSize="11sp"
                android:text="@string/chk_keep_screen_on" />
        </LinearLayout>
    </LinearLayout>

    <!--
      Notifikasi penyimpanan. Muncul dengan animasi kecil saat ekspor
      dimulai dan selesai ("Menyimpan…" lalu "Tersimpan: nama file").
      Ditaruh tepat di atas panel kontrol — dekat dengan tombol yang
      ditekan, tanpa menutupi video.
    -->
    <TextView
        android:id="@+id/saveToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_save_toast"
        android:clickable="false"
        android:focusable="false"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="3"
        android:maxWidth="320dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="@color/panel_accent"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/controlPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>