<?xml version="1.0" encoding="utf-8"?>
<!--
  WebView penuh, tanpa split. Panel kontrol berupa bar melayang di bawah:
  ringkas menampilkan satu baris teks subtitle yang sedang live, dan saat
  diketuk memunculkan tombol-tombolnya.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_bottom">

    <!--
      Wadah video. WebView ada di dalamnya, dan tampilan fullscreen native
      (custom view dari WebChromeClient) ditambahkan ke wadah yang sama
      saat halaman meminta fullscreen.

      Badge dan bar melayang sengaja DI LUAR wadah ini dan ditulis setelah
      pada layout, jadi keduanya tetap berada di atas video fullscreen.
    -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!--
      Layar sapaan. Muncul sesaat setelah episode diketuk dari Home:
      thumbnail, judul, dan status menyiapkan pemain. Meluruh keluar begitu
      <video> di halaman hidup, supaya yang terlihat setelahnya adalah
      pemain dalam tampilan yang sudah benar — bukan halaman yang setengah
      terpasang.

      Sengaja clickable: selama pemain belum siap, sentuhan ditahan di
      sini supaya tidak mengenai area WebView yang belum siap.
    -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/splashContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <ImageView
                android:id="@+id/splashCover"
                android:layout_width="220dp"
                android:layout_height="124dp"
                android:background="@drawable/bg_thumb"
                android:clipToOutline="true"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/splashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/splashStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!--
      Indikator nomor cue. Isinya satu angka saja: jumlah cue yang sudah
      terekam. Hanya muncul saat video fullscreen; di tampilan biasa
      disembunyikan supaya pojok layar bersih.

      Sengaja tidak clickable/focusable: view yang tidak mengonsumsi
      sentuhan akan dilewati, dan event-nya jatuh ke WebView di
      bawahnya. Jadi area ini tetap bisa dipakai seperti biasa.
    -->
    <TextView
        android:id="@+id/cueBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_cue_badge"
        android:clickable="false"
        android:focusable="false"
        android:fontFamily="monospace"
        android:gravity="center"
        android:minWidth="26dp"
        android:minHeight="26dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/panel_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      Bar melayang. Tingginya mengikuti isi: satu baris saat ringkas,
      bertambah saat panel tombol ditampilkan.
    -->
    <LinearLayout
        android:id="@+id/liveBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_live_bar"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Baris ringkas: teks live + penanda. Seluruh baris bisa diketuk. -->
        <LinearLayout
            android:id="@+id/liveRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="28dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/liveText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/panel_accent"
                android:text="@string/panel_idle" />

            <TextView
                android:id="@+id/chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:textSize="12sp"
                android:textColor="@color/panel_accent"
                android:text="&#x25B2;" />
        </LinearLayout>

        <!-- Panel tombol. Awalnya tersembunyi. -->
        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textColor="@color/panel_text" />

            <CheckBox
                android:id="@+id/chkKeepScreenOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="11sp"
                android:textColor="@color/panel_text"
                android:text="@string/chk_keep_screen_on" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <Button
                    android:id="@+id/btnPickFolder"
                    style="@style/ThinButton"
                    android:text="@string/btn_pick_folder" />

                <Button
                    android:id="@+id/btnReset"
                    style="@style/ThinButton"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_reset" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <Button
                    android:id="@+id/btnSaveJson"
                    style="@style/ThinButton"
                    android:text="@string/btn_save_json" />

                <Button
                    android:id="@+id/btnSaveSrt"
                    style="@style/ThinButton"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_save_srt" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>