<?xml version="1.0" encoding="utf-8"?>
<!--
  Dialog konfirmasi bertema ViuSub: kepala dengan ikon peringatan, label
  monospace, judul tebal, isi, lalu dua tombol pil yang sama dengan panel
  kontrol. Semua teks diisi dari MainActivity supaya layout ini dipakai
  ulang untuk Reset dan peringatan celah ekspor.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_dialog_badge_alert">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_dialog_warning" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogEyebrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:textColor="@color/provisional_mark"
                android:textSize="9sp"
                tools:text="KONFIRMASI · RESET" />

            <TextView
                android:id="@+id/dialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/panel_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Reset rekaman?" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="Semua cue akan dihapus dan video kembali ke awal." />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="@color/divider_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialogNegative"
            style="@style/ThinButton"
            android:text="@string/dialog_cancel" />

        <Button
            android:id="@+id/dialogPositive"
            style="@style/PrimaryButton"
            android:layout_marginStart="8dp"
            tools:text="Reset" />
    </LinearLayout>
</LinearLayout>
