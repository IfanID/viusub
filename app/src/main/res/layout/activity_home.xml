<?xml version="1.0" encoding="utf-8"?>
<!--
  Daftar episode dengan kepala bergaya konsol siaran: eyebrow cyan, judul
  tebal, dan kontrol muat ulang yang tetap terjangkau. Kotak cari menempel
  di bawah supaya mudah dijangkau ibu jari.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_bottom"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo_symbol_cyan" />

                <TextView
                    android:id="@+id/homeEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.18"
                    android:text="@string/home_eyebrow"
                    android:textColor="@color/panel_accent"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/home_title"
                android:textColor="@color/panel_text"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDnsInfo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/dns_info_desc"
            android:padding="10dp"
            android:src="@drawable/ic_dns_info"
            android:tooltipText="@string/dns_info_desc" />

        <ImageButton
            android:id="@+id/btnViuLogin"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/home_menu_desc"
            android:padding="10dp"
            android:src="@drawable/ic_menu"
            android:tooltipText="@string/home_menu_desc" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/home_refresh"
                android:padding="10dp"
                android:src="@drawable/ic_refresh" />

            <ProgressBar
                android:id="@+id/refreshProgress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/panel_accent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_live_dot" />

        <TextView
            android:id="@+id/range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:textColor="@color/meta_text"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:scrollbars="vertical" />

        <!-- Header tahun lengket. Diletakkan sebagai view asli di atas
             daftar supaya selalu rata dengan tepi atas, bukan digambar di
             kanvas RecyclerView yang bisa meleset beberapa dp. -->
        <TextView
            android:id="@+id/stickyYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_year_header"
            android:clickable="false"
            android:drawableStart="@drawable/bg_year_mark"
            android:drawablePadding="9dp"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:paddingStart="16dp"
            android:paddingTop="15dp"
            android:paddingEnd="16dp"
            android:paddingBottom="7dp"
            android:textColor="@color/panel_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="14dp"
            android:drawableTop="@drawable/ic_subtitles"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:textColor="@color/meta_text"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_live_dot" />

            <TextView
                android:id="@+id/status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:maxLines="2"
                android:text="@string/home_loading"
                android:textColor="@color/meta_text"
                android:textSize="11sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:hint="@string/home_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="50dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="@color/panel_text"
            android:textColorHint="@color/meta_text"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
