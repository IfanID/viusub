<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="2dp"
        android:left="6dp"
        android:right="6dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#12FFB74D" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#4DFFB74D" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:gravity="start"
        android:left="6dp"
        android:top="2dp"
        android:width="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/provisional_mark" />
            <corners
                android:bottomLeftRadius="8dp"
                android:topLeftRadius="8dp" />
        </shape>
    </item>
</layer-list>
