<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu menu popup: permukaan gelap dengan garis tipis, sama dengan
     kartu lain di aplikasi. Sudut membulat supaya terlihat seperti menu
     yang menempel, bukan dialog. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_raised" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/surface_border" />
</shape>
