<?xml version="1.0" encoding="utf-8"?>
<!-- Panel status kecil untuk lompatan transkrip: bukan media bar, hanya
     satu baris yang muncul saat ada lompatan dan hilang setelah selesai. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="@color/jump_stroke" />
</shape>
