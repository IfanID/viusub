<?xml version="1.0" encoding="utf-8"?>
<!-- Badge cue di fullscreen: permukaan gelap transparan dengan garis cyan
     tipis. Isinya ikon Cue Brackets, bukan angka, supaya tidak menarik
     perhatian saat menonton. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#A6000000" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="@color/jump_stroke" />
</shape>
